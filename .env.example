# =============================================================================
# BelloAcademy — modèle de configuration d'environnement
# Copiez ce fichier vers apps/web/.env (ou lancez `bash scripts/setup-env.sh`)
# et remplacez toutes les valeurs marquées CHANGEZ_MOI.
# Aucun secret réel ne doit être committé dans Git.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_URL="http://localhost:3000"
APP_NAME="BelloAcademy"
# Secret de signature des sessions et jetons (>= 32 caractères aléatoires)
# Générer : openssl rand -base64 48
AUTH_SECRET="CHANGEZ_MOI_secret_de_developpement_32_caracteres_minimum"

# --- Base de données ---------------------------------------------------------
# Rôle applicatif : soumis aux politiques RLS, utilisé par le runtime Next.js.
DATABASE_URL="postgresql://belloacademy_app:belloacademy_app_dev@127.0.0.1:5432/belloacademy"
# Rôle plateforme (BYPASSRLS) : superadministration et facturation inter-organisations.
DATABASE_PLATFORM_URL="postgresql://belloacademy_platform:belloacademy_platform_dev@127.0.0.1:5432/belloacademy"
# Rôle propriétaire : utilisé uniquement par les migrations Prisma.
MIGRATE_DATABASE_URL="postgresql://belloacademy_owner:belloacademy_owner_dev@127.0.0.1:5432/belloacademy"
# Base « shadow » utilisée par `prisma migrate dev` pour calculer les diffs.
SHADOW_DATABASE_URL="postgresql://belloacademy_owner:belloacademy_owner_dev@127.0.0.1:5432/belloacademy_shadow"
# Connexion au rôle de vérification RLS (tests d'isolation uniquement).
# Base de test dédiée aux tests d'intégration (jamais la base de développement).
TEST_DATABASE_URL="postgresql://belloacademy_app:belloacademy_app_dev@127.0.0.1:5432/belloacademy_test"
TEST_PLATFORM_DATABASE_URL="postgresql://belloacademy_platform:belloacademy_platform_dev@127.0.0.1:5432/belloacademy_test"
TEST_MIGRATE_DATABASE_URL="postgresql://belloacademy_owner:belloacademy_owner_dev@127.0.0.1:5432/belloacademy_test"
TEST_SHADOW_DATABASE_URL="postgresql://belloacademy_owner:belloacademy_owner_dev@127.0.0.1:5432/belloacademy_test_shadow"

# --- Cache / file d'attente --------------------------------------------------
# Facultatif : sans REDIS_URL, un cache mémoire local est utilisé (mono-processus).
# REDIS_URL="redis://127.0.0.1:6379"
REDIS_URL=""

# --- Stockage de fichiers ----------------------------------------------------
# "local"  : stockage sur disque (développement), servi via une route authentifiée.
# "s3"     : tout stockage compatible S3 (MinIO auto-hébergé, AWS S3, Scaleway...).
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./var/storage"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="belloacademy"
S3_ACCESS_KEY_ID="CHANGEZ_MOI_minio_access_key"
S3_SECRET_ACCESS_KEY="CHANGEZ_MOI_minio_secret_key"
S3_FORCE_PATH_STYLE="true"
# Durée de validité des URL présignées (secondes)
S3_PRESIGN_TTL_SECONDS="900"
# Taille maximale d'un fichier téléversé (Mo)
MAX_UPLOAD_MB="50"

# --- Jitsi Meet --------------------------------------------------------------
# "public"       : serveur public meet.jit.si (démonstration uniquement)
# "self-hosted"  : instance Jitsi auto-hébergée (recommandé en production)
JITSI_MODE="public"
JITSI_DOMAIN="meet.jit.si"
JITSI_APP_ID=""
JITSI_APP_SECRET=""
JITSI_REQUIRE_JWT="false"
JITSI_JWT_AUDIENCE="jitsi"
JITSI_JWT_ISSUER="belloacademy"

# --- E-mail ------------------------------------------------------------------
# "log"  : écrit les e-mails dans var/mail (mode test local, aucun envoi réseau)
# "smtp" : envoi réel via SMTP
MAIL_DRIVER="console"
MAIL_FROM="BelloAcademy <no-reply@belloacademy.local>"
MAIL_SPOOL_DIR="./var/mail"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Paiements ---------------------------------------------------------------
# "mock"   : mode test explicite (aucun paiement réel, jamais présenté comme confirmé)
# "stripe" : prestataire réel, nécessite les clés ci-dessous
PAYMENT_PROVIDER="mock"
MOCK_PAYMENT_AUTO_CONFIRM="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# --- Divers ------------------------------------------------------------------
# Autorise la création d'une organisation par un utilisateur (mode SaaS public)
ALLOW_SELF_SERVICE_ORGS="true"
# Adresse de l'équipe support affichée dans l'interface
SUPPORT_EMAIL="support@belloacademy.local"
# Active l'en-tête HSTS et les redirections HTTPS (à activer derrière le proxy)
FORCE_HTTPS="false"
